# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Client -> serverless API base (leave blank when API routes are same-origin)
VITE_API_URL=

# MTN MoMo (client)
# Dev convenience only: pre-fills the phone input, never used silently in production.
VITE_MTN_SANDBOX_MSISDN=250788123456
# Optional override; server already defaults to EUR in sandbox / RWF in production.
VITE_MTN_CURRENCY=

# MTN MoMo (server, api/mtn/*)
MTN_API_USER_ID=
MTN_API_USER_PASSWORD=
MTN_PRIMARY_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_COLLECTION_API_URL=https://sandbox.momodeveloper.mtn.com/collection
MTN_CURRENCY=
MTN_CALLBACK_URL=

# PesaPal (server, api/pesapal/*) — currently unused by the UI, see PESAPAL_SETUP.md
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_CALLBACK_URL=
PESAPAL_NOTIFICATION_URL=
PESAPAL_NOTIFICATION_ID=

# Shared
PUBLIC_SITE_URL=
