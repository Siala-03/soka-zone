# Client-side configuration
# On Vercel, leave VITE_API_URL empty when the frontend and API routes share the same domain.
VITE_PESAPAL_ENV=production
VITE_API_URL=

# Server-side PesaPal configuration
# Add these as Environment Variables in the Vercel project settings.
PESAPAL_ENV=production
PESAPAL_CONSUMER_KEY=your_live_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_live_consumer_secret_here
PUBLIC_SITE_URL=https://sokazone.rw
PESAPAL_CALLBACK_URL=https://sokazone.rw/payment/callback
PESAPAL_NOTIFICATION_URL=https://sokazone.rw/api/pesapal/notify
PESAPAL_NOTIFICATION_ID=your_registered_ipn_id_here

# Firebase configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

